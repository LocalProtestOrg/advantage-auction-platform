{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advantage.bid/contracts/3p/reference.schema.json",
  "title": "Owner-approved creative reference — sidecar metadata record (Phase 3P)",
  "description": "One record per image in docs/marketing/approved-creative-examples/. Generated by Desktop Marketing or the indexer; the Owner never edits these by hand. Identity is the image content hash so files may be moved between folders without losing their record. Reference images are calibration evidence, never templates: nothing in this record is a layout to reproduce.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_id",
    "identity",
    "owner_status",
    "owner_weight",
    "status_history",
    "source",
    "classification",
    "visual_read",
    "measured",
    "strongest_attributes",
    "transferable_lessons",
    "do_not_generalize",
    "text_density_assessment",
    "composition_assessment",
    "retrieval",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "reference_id": {
      "type": "string",
      "pattern": "^REF-[0-9]{2,4}$",
      "description": "Stable human-readable id. Assigned once; never reused after retirement."
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "current_path", "original_filename", "width", "height", "format_class", "aspect_ratio"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Primary key. Hash of the image bytes." },
        "current_path": { "type": "string", "description": "Path relative to the library root at last index build. Informational; may change when the Owner moves a file." },
        "original_filename": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "format_class": { "enum": ["portrait", "square", "landscape"] },
        "aspect_ratio": { "type": "number" }
      }
    },
    "owner_status": {
      "enum": ["OWNER_APPROVED", "OWNER_GOLD_STANDARD", "OWNER_DO_NOT_USE", "RETIRED"],
      "description": "OWNER_APPROVED: in the library by the Owner's choice. OWNER_GOLD_STANDARD: explicitly promoted by the Owner; heavier calibration weight. OWNER_DO_NOT_USE: kept as negative evidence, never retrieved as a positive reference. RETIRED: file removed; record kept for provenance."
    },
    "owner_weight": {
      "type": "number",
      "description": "Derived from owner_status by the weighting model (APPROVED 1.0, GOLD 2.0, DO_NOT_USE -1.0, RETIRED 0). Stored for audit; the indexer recomputes it."
    },
    "status_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "status", "source", "recorded_by"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "status": { "enum": ["OWNER_APPROVED", "OWNER_GOLD_STANDARD", "OWNER_DO_NOT_USE", "RETIRED"] },
          "source": {
            "enum": ["folder_placement_by_owner", "owner_statement_via_desktop_marketing", "owner_folder_move", "admin_ui_button", "owner_review_of_generated_creative"],
            "description": "How the decision reached the system. The Owner never edits this file."
          },
          "owner_words": { "type": "string", "description": "The Owner's own words when a statement was the source, verbatim." },
          "recorded_by": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seller", "origin", "rights"],
      "properties": {
        "seller": { "type": "string", "description": "Whose creative this is, as visible in the image. 'Advantage.Bid' for the platform's own approved outputs." },
        "origin": { "type": "string" },
        "rights": { "type": "string", "description": "Third-party seller artwork is calibration evidence only and is never reproduced, passed to a generator as image input, or published." },
        "campaign_title_visible": { "type": "string", "description": "Only text actually visible in the image." },
        "event_date_visible": { "type": "string", "description": "Only text actually visible in the image." },
        "advantage_bid_visible": { "type": "boolean" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_class_primary", "campaign_class_secondary", "owner_folder", "event_product_type", "seller_hierarchy", "visual_family", "nearest_advantage_family", "event_mode", "merchandise_breadth"],
      "properties": {
        "campaign_class_primary": { "$ref": "#/$defs/CampaignClass" },
        "campaign_class_secondary": { "type": "array", "items": { "$ref": "#/$defs/CampaignClass" } },
        "owner_folder": { "type": "string", "description": "The category folder the Owner placed the file in. Recorded as given, never overridden." },
        "event_product_type": { "type": "string" },
        "seller_hierarchy": { "enum": ["seller_led_solo", "seller_led_cobranded", "advantage_bid_led", "advantage_bid_only", "unknown"] },
        "visual_family": { "$ref": "#/$defs/VisualFamily" },
        "nearest_advantage_family": {
          "enum": ["CENTERED_WHITE", "LEFT_THIRD_WHITE", "CATEGORY_GROUP", "SINGLE_LOT", "CLOSING_DAYS", "COBRANDED", "ENVIRONMENTAL_PHOTO", "CATALOG_SCATTER", "NONE"],
          "description": "The existing Phase 3O CreativeFamily this reference informs, plus the two families Phase 3P proposes (ENVIRONMENTAL_PHOTO, CATALOG_SCATTER)."
        },
        "event_mode": { "enum": ["online_only", "in_house_or_online", "on_site", "not_an_event", "unknown"] },
        "merchandise_breadth": { "enum": ["broad", "category_group", "single_category", "single_object", "representative_non_lot", "none"] }
      }
    },
    "visual_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_hierarchy", "merchandise_treatment", "composition_style", "typography_treatment", "information_density", "branding_hierarchy", "cta_treatment", "footer_treatment", "photographic_style", "overlapping_objects", "environmental_staged_composition", "negative_space", "ground", "overall_visual_impact"],
      "properties": {
        "visual_hierarchy": { "type": "string" },
        "merchandise_treatment": { "type": "string" },
        "composition_style": { "type": "string" },
        "typography_treatment": { "type": "string" },
        "information_density": { "enum": ["none", "low", "medium", "high"] },
        "branding_hierarchy": { "type": "string" },
        "cta_treatment": { "type": "string" },
        "footer_treatment": { "type": "string" },
        "photographic_style": { "type": "string" },
        "overlapping_objects": { "enum": ["none", "light", "confident", "physical_still_life"] },
        "environmental_staged_composition": { "type": "string" },
        "negative_space": { "enum": ["minimal", "modest", "generous"] },
        "ground": { "enum": ["white", "cream", "dark", "photograph", "mixed"] },
        "overall_visual_impact": { "enum": ["moderate", "high", "very_high"] }
      }
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light_pixel_pct", "dark_pixel_pct", "saturated_pixel_pct", "dominant_hues", "est_merchandise_share_pct", "est_text_share_pct", "object_count_est", "text_block_count"],
      "description": "light/dark/saturated and hues are computed from pixels. est_* and counts are the analyst's visual estimates, labelled as such; they are calibration bands, not facts about the seller's ad.",
      "properties": {
        "light_pixel_pct": { "type": "number" },
        "dark_pixel_pct": { "type": "number" },
        "saturated_pixel_pct": { "type": "number" },
        "dominant_hues": { "type": "array", "items": { "type": "string" } },
        "est_merchandise_share_pct": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "[low, high] visual estimate." },
        "est_text_share_pct": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "object_count_est": { "type": "integer", "minimum": 0 },
        "text_block_count": { "type": "integer", "minimum": 0, "description": "Copy blocks excluding the seller logo and footer URL/wordmark — same counting rule as spatial.text_budget_audit." }
      }
    },
    "strongest_attributes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "transferable_lessons": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Principles Advantage.Bid may adopt. Never coordinates, colours, typefaces, ornaments or wording of the seller." },
    "do_not_generalize": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Seller- or event-specific elements that must NOT become Advantage.Bid house style." },
    "text_density_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "why_it_works_here", "advantage_bid_budget_note"],
      "properties": {
        "level": { "enum": ["none", "low", "medium", "high"] },
        "why_it_works_here": { "type": "string" },
        "advantage_bid_budget_note": { "type": "string" }
      }
    },
    "composition_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spatial_logic", "gravity_and_grounding", "depth", "scale_strategy", "edge_handling"],
      "properties": {
        "spatial_logic": { "type": "string" },
        "gravity_and_grounding": { "type": "string" },
        "depth": { "type": "string" },
        "scale_strategy": { "type": "string" },
        "edge_handling": { "type": "string" }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_cases", "tags", "avoid_for"],
      "properties": {
        "use_cases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "avoid_for": { "type": "array", "items": { "type": "string" } }
      }
    },
    "performance": {
      "type": ["object", "null"],
      "description": "Reserved. Campaign performance is a separate signal and never changes owner_status or owner_weight.",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "created_at", "analysis_method", "phase"],
      "properties": {
        "created_by": { "type": "string" },
        "created_at": { "type": "string" },
        "analysis_method": { "type": "string" },
        "phase": { "type": "string" }
      }
    }
  },
  "$defs": {
    "CampaignClass": {
      "type": "string",
      "enum": [
        "estate_sale",
        "auction",
        "professional_seller_acquisition",
        "individual_seller_acquisition",
        "buyer_platform_growth",
        "notable_lot",
        "closing_soon",
        "geographic_event_promotion",
        "general_brand"
      ]
    },
    "VisualFamily": {
      "type": "string",
      "enum": [
        "SCENE_EXTRACTED",
        "LEFT_PANEL_EXTRACTED",
        "PHOTO_STILL_LIFE",
        "ENVIRONMENTAL_ROOM",
        "TILE_GRID",
        "LINEUP",
        "CATALOG_SCATTER",
        "HERO_SINGLE_DARK",
        "ATMOSPHERIC_SCENE"
      ],
      "description": "How the reference is built visually, independent of what it advertises. SCENE_EXTRACTED: extracted objects composed as a believable staged scene on a light ground. LEFT_PANEL_EXTRACTED: information panel on one side, extracted objects on the other. PHOTO_STILL_LIFE: one real photograph of physically arranged merchandise. ENVIRONMENTAL_ROOM: photograph of the actual sale environment. TILE_GRID: rectangular photo tiles. LINEUP: homogeneous objects in a row. CATALOG_SCATTER: many extracted objects arranged as a spread, no gravity claim. HERO_SINGLE_DARK: one dramatic object on a dark ground. ATMOSPHERIC_SCENE: mood/holiday scene, no lot claims."
    }
  }
}

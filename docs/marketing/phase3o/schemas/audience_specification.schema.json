{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advantage.bid/contracts/3o/audience_specification.schema.json",
  "title": "Audience specification (what the Director writes; resolved by the eligibility engine at send)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources",
    "permission_scope",
    "geography",
    "caps_applied",
    "suppression_applied"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "audience_sources.id with activation_state = active"
      }
    },
    "permission_scope": {
      "type": "string",
      "description": "3F permission basis required for this campaign class; unknown is never mailable"
    },
    "geography": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "https://advantage.bid/contracts/3o/enums.schema.json#/$defs/EmailScope"
        },
        "market": {
          "type": [
            "string",
            "null"
          ]
        },
        "radius_km": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "interest_ranking": {
      "type": [
        "object",
        "null"
      ]
    },
    "caps_applied": {
      "const": true
    },
    "suppression_applied": {
      "const": true
    },
    "resolved": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "pool_size": {
          "type": "integer"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Counts only; the Director never sees addresses"
    }
  }
}
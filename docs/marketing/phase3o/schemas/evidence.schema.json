{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advantage.bid/contracts/3o/evidence.schema.json",
  "title": "Evidence row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "obligation_id",
    "feature_key",
    "mode",
    "recorded_at",
    "fields"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_key": {
      "$ref": "https://advantage.bid/contracts/3o/enums.schema.json#/$defs/FeatureKey"
    },
    "mode": {
      "$ref": "https://advantage.bid/contracts/3o/enums.schema.json#/$defs/EvidenceMode"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "manual_verified only: staff id + artefact ref"
    },
    "fields": {
      "type": "object",
      "description": "Must contain every key in FEATURES[feature_key].evidence_fields before COMPLETED"
    },
    "metrics_rows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Linked performance rows the closing report may read"
    }
  },
  "x-evidence-fields": {
    "listing_standard": [
      "listing_live_at",
      "auction_id"
    ],
    "listing_card": [
      "asset_id",
      "rendered_at"
    ],
    "performance_standard": [
      "report_id",
      "rendered_at"
    ],
    "follower_launch_notification": [
      "campaign_id",
      "recipient_count",
      "sent_at"
    ],
    "featured_badge_priority": [
      "placement_reservation_id",
      "impressions",
      "clicks",
      "first_seen_at",
      "last_seen_at"
    ],
    "category_prominence": [

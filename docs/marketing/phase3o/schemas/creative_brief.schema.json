{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advantage.bid/contracts/3p/creative_brief.schema.json",
  "title": "Creative brief → compositor job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_id",
    "obligation_id",
    "auction_id",
    "family",
    "formats",
    "objects",
    "event",
    "brand_frame",
    "text_budget",
    "rule_engine"
  ],
  "properties": {
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1
    },
    "auction_id": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "$ref": "https://advantage.bid/contracts/3o/enums.schema.json#/$defs/CreativeFamily"
    },
    "formats": {
      "type": "array",
      "items": {
        "$ref": "https://advantage.bid/contracts/3o/enums.schema.json#/$defs/CreativeFormat"
      }
    },
    "objects": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "lot_id",
          "fidelity",
          "roles",
          "category"
        ],
        "properties": {
          "lot_id": {
            "type": "string",
            "minLength": 1
          },
          "fidelity": {
            "const": "CLEAN"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "https://advantage.bid/contracts/3o/enums.schema.json#/$defs/SpatialRole"
            }
          },
          "category": {
            "type": "string"
          },
          "protected_regions": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5
            }
          },
          "auction_id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          }
        }
      },
      "description": "fidelity is constrained to CLEAN at the schema level. Phase 3P: required non-empty only when merchandise_mode = lots (briefValidator); each object may carry auction_id which must equal the brief auction_id."
    },
    "event": {
      "type": "object",
      "required": [
        "title",
        "city_state",
        "date",
        "start_time"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "city_state": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "start_time": {
          "type": "string"
        },
        "typography_treatment": {
          "type": [
            "string",
            "null"
          ],
          "description": "event-specific type: e.g. red ampersand + italic; gold for a Gold event; never misleading"
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day_label": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "start": {},
              "end": {}
            }
          }
        },
        "place_name": {
          "type": "string"
        },
        "neighbourhood": {
          "type": "string"
        },
        "online_only": {
          "type": "boolean"
        }
      }
    },
    "brand_frame": {
      "type": "object",
      "required": [
        "logo_width_px",
        "kicker",
        "footer_band_px",
        "footer_wordmark",
        "footer_wordmark_px",
        "ground"
      ],
      "properties": {
        "logo_width_px": {
          "const": 250
        },
        "kicker": {
          "const": "ADVANTAGE.BID PRESENTS"
        },
        "footer_band_px": {
          "const": 120
        },
        "footer_wordmark": {
          "const": "Advantage.Bid"
        },
        "footer_wordmark_px": {
          "const": 64
        },
        "ground": {
          "enum": [
            "white",
            "very_light",
            "photograph"
          ]
        },
        "navy": {
          "const": "#182e45"
        },
        "red": {
          "const": "#d62828"
        }
      },
      "description": "STANDARDIZE THE BRAND FRAME. CUSTOMIZE THE EVENT EXPERIENCE."
    },
    "text_budget": {
      "type": "object",
      "properties": {
        "max_text_blocks": {
          "const": 5
        },
        "max_words_primary": {
          "const": 6
        },
        "max_words_support": {
          "const": 10
        },
        "profile": {
          "enum": [
            "GENERAL",
            "LOGISTICS",
            "TEASER"
          ]
        },
        "logistics_reason": {
          "type": "string"
        }
      }
    },
    "cobrand": {
      "type": "object",
      "properties": {
        "seller_name": {
          "type": "string"
        },
        "seller_logo_asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "relationship_line": {
          "type": "string"
        }
      }
    },
    "rule_engine": {
      "type": "object",
      "required": [
        "module",
        "functions"
      ],
      "properties": {
        "module": {
          "const": "spatial"
        },
        "functions": {
          "type": "array",
          "items": {
            "enum": [
              "audit",
              "text_budget_audit",
              "category_balance"
            ]
          }
        }
      },
      "description": "The existing rule engine, ported as-is; not re-implemented"
    },
    "event_id": {
      "type": "string"
    },
    "campaign_class": {
      "type": "string"
    },
    "seller_hierarchy": {
      "type": "string"
    },
    "calibration": {
      "type": "object",
      "description": "Phase 3P reference calibration block (principles.buildCalibration): principle profile + do_not_copy; never a reference image, colour, typeface or seller wording."
    },
    "merchandise_mode": {
      "enum": [
        "lots",
        "photograph",
        "representative",
        "none"
      ]
    },
    "site_photographs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "provenance_row_id": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "provenance": {
            "type": "object"
          }
        }
      }
    },
    "representative_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "rights",
          "representative_not_lots"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "rights": {
            "type": "string"
          },
          "representative_not_lots": {
            "const": true
          }
        }
      }
    },
    "screenshot": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "provenance": {
          "type": "object"
        }
      }
    },
    "claim_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "value",
          "source"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "value": {},
          "source": {
            "type": "string"
          }
        }
      }
    },
    "cta": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "factual"
          ]
        },
        "text": {
          "type": "string"
        },
        "fact_ref": {
          "type": "string"
        }
      }
    },
    "family_options": {
      "type": "object",
      "properties": {
        "title_position": {
          "enum": [
            "top",
            "bottom",
            "panel"
          ]
        },
        "teaser": {
          "type": "boolean"
        },
        "ground": {
          "enum": [
            "white",
            "very_light",
            "dark_hero",
            "photograph"
          ]
        },
        "panel_side": {
          "enum": [
            "left",
            "right"
          ]
        }
      }
    }
  }
}
